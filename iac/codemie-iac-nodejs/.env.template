# Copy this file to .env and fill in your credentials
# DO NOT commit .env to Git (it's in .gitignore)

# Codemie API Configuration
CODEMIE_API_URL=https://codemie.example.com/code-assistant-api
CODEMIE_AUTH_URL=https://keycloak.example.com/auth
CODEMIE_REALM=your-realm

# Authentication - Choose ONE of the following:

# Option 1: Client Credentials (for service accounts/CI/CD)
CODEMIE_CLIENT_ID=your-client-id
CODEMIE_CLIENT_SECRET=your-client-secret

# Option 2: Username/Password (for personal use/testing)
# CODEMIE_USERNAME=you@example.com
# CODEMIE_PASSWORD=your-password
